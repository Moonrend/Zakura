# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS bridge-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/zakura-stdio-bridge ./cmd/zakura-stdio-bridge
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -buildvcs=false -trimpath -ldflags='-s -w' -o /out/zakura-stdio-bridge ./cmd/zakura-stdio-bridge

FROM node:22-bookworm-slim AS npm
LABEL org.opencontainers.image.title="Zakura native Go stdio MCP bridge (npm)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=bridge-build /out/zakura-stdio-bridge /usr/local/bin/zakura-stdio-bridge
RUN mkdir -p /data && chown node:node /data
USER node
WORKDIR /data
EXPOSE 3100
ENTRYPOINT ["/usr/local/bin/zakura-stdio-bridge"]

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS pypi
LABEL org.opencontainers.image.title="Zakura native Go stdio MCP bridge (PyPI/uv)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=bridge-build /out/zakura-stdio-bridge /usr/local/bin/zakura-stdio-bridge
RUN mkdir -p /data
WORKDIR /data
EXPOSE 3100
ENTRYPOINT ["/usr/local/bin/zakura-stdio-bridge"]

FROM docker:27-cli AS oci
LABEL org.opencontainers.image.title="Zakura native Go stdio MCP bridge (OCI/Docker CLI)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=bridge-build /out/zakura-stdio-bridge /usr/local/bin/zakura-stdio-bridge
RUN mkdir -p /data
WORKDIR /data
EXPOSE 3100
ENTRYPOINT ["/usr/local/bin/zakura-stdio-bridge"]

FROM debian:bookworm-slim AS binary
LABEL org.opencontainers.image.title="Zakura native Go stdio MCP bridge (binary)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && mkdir -p /data
COPY --from=bridge-build /out/zakura-stdio-bridge /usr/local/bin/zakura-stdio-bridge
WORKDIR /data
EXPOSE 3100
ENTRYPOINT ["/usr/local/bin/zakura-stdio-bridge"]
