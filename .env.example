# 数据库（默认可不设，使用内嵌 PGlite：./data/pglite）
# 生产 / 自托管建议 Postgres + pgvector：
#   COMPOSE_PROFILES=postgres
#   DATABASE_URL=postgresql://zakura:zakura@postgres:5432/zakura
# DATABASE_URL=postgresql://zakura:zakura@127.0.0.1:5432/zakura

# 部署形态：oss（默认）| saas（多租户 / 自助注册）
# ZAKURA_EDITION=saas

# Docker Hub 开发镜像（compose 默认已指向这些）
# ZAKURA_IMAGE=sunwuyuan/zakura-dev:latest
# ZAKURA_WORKSPACE_IMAGE=sunwuyuan/zakura-workspace-dev:debian
# ZAKURA_RUNNER_IMAGE=sunwuyuan/zakura-runner-dev:latest

# 对外访问地址（经 nginx + Cloudflare Origin 证书）
# ZAKURA_PUBLIC_URL=https://preview.moonrend.com
# ZAKURA_WEB_URL=https://preview.moonrend.com

# 平台自托管 Headscale（控制面与数据面同机）：
# - host-ts 以 host 网络 + kernel TUN 加入本机 Headscale（tag:platform，标签来自 preauthkey）
# - 请勿在同一主机再跑个人 Tailscale 内核客户端
# - 确保 net.ipv4.ip_forward=1，便于 bridge 内 zakura 经宿主机访问 Runner 的 100.64/10
