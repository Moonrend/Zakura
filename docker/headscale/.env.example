# 公网 HTTPS 域名（须与 config/headscale.yaml 的 server_url 一致）
HEADSCALE_SERVER_URL=https://headscale.example.com
HEADPLANE_BASE_URL=https://headscale.example.com

# 宿主机端口映射
HEADSCALE_HTTP_PORT=8080
HEADSCALE_METRICS_PORT=9090
HEADSCALE_GRPC_PORT=50443
HEADSCALE_STUN_PORT=3478
HEADPLANE_HTTP_PORT=3000

# 镜像（可钉版本）
HEADSCALE_IMAGE=headscale/headscale:0.29.2
HEADPLANE_IMAGE=ghcr.io/tale/headplane:latest

TZ=UTC

# 启动 headscale 后执行：
#   docker compose exec headscale headscale apikeys create --expiration 999d
# 将输出写入下方，并同步到 config/headplane.yaml 的 headscale.api_key
HEADSCALE_API_KEY=

# Headplane cookie_secret：恰好 32 字符
#   openssl rand -hex 16
HEADPLANE_COOKIE_SECRET=CHANGE_ME_32_CHARS_COOKIE_SECRET!!

# 可选 postgres profile
# POSTGRES_DB=headscale
# POSTGRES_USER=headscale
# POSTGRES_PASSWORD=changeme
