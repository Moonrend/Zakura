# Zakura reverse proxy — Caddy + Let's Encrypt
# API：https://zakura-local-api.190823.xyz
# Web：https://zakura-local.190823.xyz；同源 /api 转发到 API 服务

{
	email {$CADDY_ACME_EMAIL:admin@moonrend.com}
	servers {
		protocols h1 h2
	}
}

zakura-local-api.190823.xyz {
	request_body {
		max_size 100MB
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	reverse_proxy zakura:8787 {
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

zakura-local.190823.xyz {
	request_body {
		max_size 100MB
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	# 前端使用同源 /api；这里转发到独立 API 服务。
	# flush_interval -1：SSE 禁缓冲（见 docs/deployment.md）
	handle /api/* {
		reverse_proxy zakura:8787 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	# /v1 与 /v1/*（裸路径也要进 API；勿只写 /v1/*）
	handle /v1* {
		reverse_proxy zakura:8787 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	handle {
		reverse_proxy zakura:3001
	}
}

# Headscale 控制面 + Headplane UI
zakura-network.moonrend.com {
	request_body {
		max_size 32MB
	}

	handle /admin* {
		reverse_proxy headplane:3000
	}

	handle {
		reverse_proxy headscale:8080 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
}
