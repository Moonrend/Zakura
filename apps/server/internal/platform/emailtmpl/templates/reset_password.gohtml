{{define "content"}}
{{if .SetPassword}}
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;">为你的 Zakura 账号设置密码。链接 1 小时内有效。</p>
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;"><a href="{{safeURL .ResetURL}}" style="color:#0b57d0;text-decoration:underline;">设置密码</a></p>
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;">如果不是你本人操作，请忽略此邮件。</p>
{{else}}
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;">你请求重置密码。链接 1 小时内有效。</p>
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;"><a href="{{safeURL .ResetURL}}" style="color:#0b57d0;text-decoration:underline;">重置密码</a></p>
<p style="font-size:15px;line-height:1.7;color:#222222;margin:0 0 16px;">如果不是你本人操作，请忽略此邮件，密码不会被更改。</p>
{{end}}
{{end}}
