      {
        "kind": "connector",
        "ref": "google-workspace",
        "name": "Google Workspace",
        "description": "直接调用 Google Workspace REST API，不依赖外部 MCP 服务。",
        "config": {
          "providerId": "google-workspace",
          "auth": { "kind": "oauth2", "profile": "google-workspace" },
