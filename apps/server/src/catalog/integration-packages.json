            { "key": "clientId", "label": "Client ID", "type": "text", "required": true, "placeholder": "*.apps.googleusercontent.com" },
            { "key": "clientSecret", "label": "Client Secret", "type": "secret", "required": true }
          ]
        }
      },
      { "kind": "tool", "ref": "google-gmail", "name": "Gmail", "description": "搜索邮件、管理标签和草稿，并在授权后发送邮件。", "config": { "providerId": "google-workspace", "product": "gmail", "mcpUrl": "zakura://google-workspace/gmail", "scopes": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send" } },
      { "kind": "tool", "ref": "google-drive", "name": "Google Drive", "description": "搜索、读取和管理云端文件。", "config": { "providerId": "google-workspace", "product": "drive", "mcpUrl": "zakura://google-workspace/drive", "scopes": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file" } },
      { "kind": "tool", "ref": "google-calendar", "name": "Google Calendar", "description": "读取空闲时间并管理日程。", "config": { "providerId": "google-workspace", "product": "calendar", "mcpUrl": "zakura://google-workspace/calendar", "scopes": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.freebusy https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/calendar.events" } },
      { "kind": "tool", "ref": "google-people", "name": "Google People", "description": "查找联系人和组织通讯录。", "config": { "providerId": "google-workspace", "product": "people", "mcpUrl": "zakura://google-workspace/people", "scopes": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/directory.readonly" } },
      { "kind": "tool", "ref": "google-chat", "name": "Google Chat", "description": "读取空间与消息并发送回复。", "config": { "providerId": "google-workspace", "product": "chat", "mcpUrl": "zakura://google-workspace/chat", "scopes": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/chat.spaces.readonly https://www.googleapis.com/auth/chat.memberships.readonly https://www.googleapis.com/auth/chat.messages.readonly https://www.googleapis.com/auth/chat.messages.create" } },
