{
  "name": "@zakura/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:stdio-bridge && tsx watch src/index.ts",
    "build": "pnpm run build:stdio-bridge && tsc -p tsconfig.json",
    "build:stdio-bridge": "node scripts/build-stdio-bridge.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "mcp:conformance": "tsx scripts/run-mcp-conformance.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.3",
    "@hono/node-server": "^1.14.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@zakura/core": "workspace:*",
    "@zakura/saas": "workspace:*",
    "@zakura/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.6",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "hono": "^4.7.11",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.38",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
