{
  "name": "@zakura/oauth-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone OAuth 2.1 bridge for upstreams without DCR (e.g. Google)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
